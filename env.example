# Copy to .env.local and fill values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret

# Auth0 OAuth
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://<your-tenant>.<region>.auth0.com
# Include only if you need API access tokens
AUTH0_AUDIENCE=

# Roles claim namespace used in ID token (must match Auth0 action/rule)
# Example: https://your-app/
AUTH0_NAMESPACE=

# Optional: tweak logging
NODE_ENV=development
